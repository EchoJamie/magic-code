#!/usr/bin/env sh
# 提交门禁：暂存树的类型检查、结构守护与快速回归。
# 完整集成与端到端回归由 bun run check 和 PR 检查执行。
set -e

snapshot="$(mktemp -d)"
trap 'rm -rf "$snapshot"' EXIT INT TERM

git checkout-index -a -f --prefix="$snapshot/"

cd "$snapshot"
# 从已有缓存按暂存锁文件安装，使 workspace 链接也属于暂存树。
# 不联网、不执行 prepare；不能引用工作区 node_modules 中指回源码的链接。
if ! bun install --offline --frozen-lockfile --ignore-scripts; then
  echo "质量闸：暂存依赖的离线安装失败；请核对 package.json / bun.lock，并先运行 bun install 准备依赖缓存。" >&2
  exit 1
fi
bun run check:commit
