    {
      "cmd": "key",
      "session": "乙",
      "key": "enter",
      "wait": {
        "text": "已转后台"
      },
      "timeoutMs": 200000
    },
    {
      "cmd": "capture",
      "session": "乙",
      "label": "01-长活跑过 120 秒：转到后台（不是被掐断）"
    },
    {
      "cmd": "wait",
      "session": "乙",
      "condition": {
        "text": "构建没被掐断"
      },
      "timeoutMs": 30000
    },
    {
      "cmd": "wait",
      "session": "乙",
      "condition": {
        "text": "bg-1 跑完了"
      },
      "timeoutMs": 30000
    },
    {
      "cmd": "capture",
      "session": "乙",
      "label": "02-模型读到的那个意思（没被掐、接着在跑）"
    },
    {
      "cmd": "quit",
      "session": "乙"
    },
    {
      "cmd": "close",
      "session": "乙"
    }
  ]
