{
  "label": "u69-到点转后台那一屏（U76：判轻默认通 ⇒ 这一趟没有裁决卡）",
  "steps": [
    {
      "cmd": "start",
      "as": "甲",
      "cols": 200,
      "rows": 40,
      "turns": [
        {
          "kind": "tool",
          "name": "exec",
          "args": {
            "command": "echo '正在下载依赖 10%'; echo '正在下载依赖 55%'; sleep 4",
            "timeoutMs": 1000
          }
        },
        {
          "kind": "text",
          "text": "到点还没跑完，它接着在后台跑——编号和输出文件都在回执里，我不当它是没跑。"
        }
      ]
    },
    {
      "cmd": "send",
      "session": "甲",
      "text": "把依赖装一下"
    },
    {
      "cmd": "key",
      "session": "甲",
      "key": "enter",
      "wait": {
        "text": "已转后台"
      },
      "timeoutMs": 30000
    },
    {
      "cmd": "capture",
      "session": "甲",
      "label": "01-到点转后台那一屏（这一次带了 timeoutMs）"
    },
    {
      "cmd": "wait",
      "session": "甲",
      "condition": {
        "text": "我不当它是没跑"
      },
      "timeoutMs": 30000
    },
    {
      "cmd": "wait",
      "session": "甲",
      "condition": {
        "text": "bg-1 跑完了"
      },
      "timeoutMs": 30000
    },
    {
      "cmd": "capture",
      "session": "甲",
      "label": "02-模型读到的那个意思（它没当「没跑」）"
    },
    {
      "cmd": "quit",
      "session": "甲"
    },
    {
      "cmd": "close",
      "session": "甲"
    }
  ]
