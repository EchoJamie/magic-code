{
  "label": "u69-长活不被掐（U76：判轻默认通 ⇒ 这一趟没有裁决卡）",
  "steps": [
    {
      "cmd": "start",
      "as": "乙",
      "cols": 100,
      "rows": 30,
      "turns": [
        {
          "kind": "tool",
          "name": "exec",
          "args": {
            "cmd": "sleep 125 && echo 构建完成"
          }
        },
        {
          "kind": "text",
          "text": "构建跑到底了——没设上界，也就没人掐它。"
        }
      ]
    },
    {
      "cmd": "send",
      "session": "乙",
      "text": "构建一下"
    },
    {
      "cmd": "key",
      "session": "乙",
      "key": "enter",
      "wait": {
        "text": "✓"
      },
      "timeoutMs": 200000
    },
    {
      "cmd": "capture",
      "session": "乙",
      "label": "01-长活跑到自己结束（125.0s，活过了 120 秒那个旧常量）"
    },
    {
      "cmd": "wait",
      "session": "乙",
      "condition": {
        "text": "没人掐它"
      },
      "timeoutMs": 30000
    },
    {
      "cmd": "capture",
      "session": "乙",
      "label": "02-模型读到的那个意思（没设上界、没人掐它）"
    },
    {
      "cmd": "quit",
      "session": "乙"
    },
    {
      "cmd": "close",
      "session": "乙"
    }
  ]
}
