{
  "name": "magic-code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test ./packages",
    "test:fast": "bun test ./test ./packages --path-ignore-patterns='**/*.integration.test.ts' --path-ignore-patterns='**/*.e2e.test.ts'",
    "test:integration": "bun test ./test/*.integration.test.ts ./packages/*/test/*.integration.test.ts",
    "test:e2e": "bun test ./packages/*/test/*.e2e.test.ts",
    "check:commit": "bun run typecheck && bun run test:fast",
    "check": "bun run typecheck && bun run test",
    "build:macos": "bash scripts/macos/build.sh",
    "check:macos": "bash scripts/macos/build.sh && bash scripts/macos/check.sh && bash scripts/macos/verify.sh",
    "check:all": "bun run check && bun run check:macos",
    "prepare": "git config core.hooksPath .githooks || true",
    "ui": "bun packages/app/scripts/ui.ts",
    "build:terminal": "bash scripts/macos/package-components.sh terminal",
    "build:engine": "bash scripts/macos/package-components.sh engine"
  },
  "dependencies": {
    "@magic/app": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  },
  "patchedDependencies": {
    "undici@7.29.1": "patches/undici@7.29.1.patch"
  }
}
