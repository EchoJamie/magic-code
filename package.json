{
  "name": "magic-code",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/*/*",
    "apps/*",
    "test/*"
  ],
  "scripts": {
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test ./test ./packages ./apps",
    "test:fast": "bun test ./test ./packages ./apps --path-ignore-patterns='**/*.integration.test.ts' --path-ignore-patterns='**/*.e2e.test.ts'",
    "test:integration": "bun scripts/test-layer.ts integration",
    "test:e2e": "bun scripts/test-layer.ts e2e",
    "check:imports": "bun scripts/import-guard.ts",
    "check:commit": "bun run typecheck && bun run check:imports && bun run test:fast",
    "check": "bun run typecheck && bun run check:imports && bun run test",
    "build:macos": "bash scripts/macos/build.sh",
    "check:macos": "bash scripts/macos/build.sh && bash scripts/macos/check.sh && bash scripts/macos/verify.sh",
    "check:all": "bun run check && bun run check:macos",
    "prepare": "git config core.hooksPath .githooks || true",
    "ui": "bun apps/cli/scripts/ui.ts",
    "build:terminal": "bash scripts/macos/package-components.sh terminal",
    "build:engine": "bash scripts/macos/package-components.sh engine"
  },
  "dependencies": {
    "@magic/cli": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  },
  "patchedDependencies": {
    "undici@7.29.1": "patches/undici@7.29.1.patch"
  }
}
